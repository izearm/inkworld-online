{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM"],
    "strict": true, "noEmit": true, "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true,
    "noUnusedLocals": true, "types": ["node", "vite/client"], "allowImportingTsExtensions": false
  },
  "include": ["src", "tests", "editor", "tools/parity-entry.ts"]
}
